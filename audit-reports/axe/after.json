            ".tape-item:nth-child(11) > i",
            ".tape-item:nth-child(12) > i",
            ".award-card.red:nth-child(1) > .award-num > i",
            ".contact-title > span:nth-child(1)",
            ".contact-title > span:nth-child(2)",
            ".ce-user",
            ".ce-domain"
          ]
        }
      ]
    }
  }
}